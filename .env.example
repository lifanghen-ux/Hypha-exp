# Copy this file to .env and fill in local values.
# Never commit real passwords, tokens, or API keys.

# Read-only pinned SPP checkout on the benchmark host.
HYPHA_SPP_ROOT=/root/codespace/MIA-exp/benchmarks/SPP
HYPHA_SPP_DATA_ROOT=/root/codespace/MIA-exp/benchmarks/SPP/data

# OpenAI-compatible inference used by the Hypha SPP adapter.
HYPHA_MODEL=deepseek-v4-flash
HYPHA_SPP_MAX_TOKENS=8192
HYPHA_OPENAI_BASE_URL=
HYPHA_API_KEY=
